{
  "name": "shipstrike-3d",
  "description": "ShipStrike-3D Multiplayer Naval Combat Game",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:both",
    "dev:both": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "cd frontend && npm run build",
    "build:server": "echo \"Server is a Node.js app, no build needed\"",
    "start": "npm run start:server",
    "start:server": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "frontend",
    "server"
  ]
}
