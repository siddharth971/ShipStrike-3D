# ShipStrike-3D Server Configuration

# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/shipstrike
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Game Settings
MAP_SIZE=4000
TICK_RATE=60
MAX_PLAYERS_PER_SERVER=90

# Logging
LOG_LEVEL=debug
